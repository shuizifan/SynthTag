// SynthTag 应用图标资源
// 编译: zig rc build/app.rc build/app.res
// 然后作为输入传给 zig cc 一起链接进 exe
1 ICON "../assets/SynthTag.ico"

1 VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "SynthTag\0"
   VALUE "FileDescription", "SynthTag (AI Tagging)\0"
   VALUE "FileVersion", "1.3.0\0"
   VALUE "InternalName", "SynthTag\0"
   VALUE "OriginalFilename", "SynthTag.exe\0"
   VALUE "ProductName", "SynthTag\0"
   VALUE "ProductVersion", "1.3.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
